rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions for DASMO Suite
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return (isAuthenticated() && request.auth.token.email.lower() == 'subhojitpaul26042004@gmail.com') ||
             (request.resource != null && request.resource.data.get('adminKey', '') == 'DASMO_ADMIN_SEC_26042004_SUBHOJIT_CYBER_KEY');
    }

    function isOwner(email) {
      return (isAuthenticated() && request.auth.token.email.lower() == email.lower()) ||
             (request.auth == null);
    }

    function isRegistrationOpen() {
      return exists(/databases/$(database)/documents/system_config/licensing) &&
             get(/databases/$(database)/documents/system_config/licensing).data.get('requireApprovalForPc', true) == false;
    }

    // =========================================================================
    // 1. DASMO SUITE COLLECTIONS
    // =========================================================================

    // System Configuration
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Photo Print Users
    match /dasmo_photo_print_users/{email} {
      allow read: if isOwner(email) || isAdmin();
      allow create: if (isOwner(email) && 
                        (email.lower() == 'subhojitpaul26042004@gmail.com' ||
                         (request.resource.data.get('isApproved', false) == false &&
                          request.resource.data.get('role', 'user') == 'user' &&
                          request.resource.data.get('status', 'pending') == 'pending'))) || isAdmin();
      allow update: if isAdmin() || 
                       (isOwner(email) && 
                        request.resource.data.get('isApproved', false) == resource.data.get('isApproved', false) &&
                        request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending') &&
                        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
                        request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
                        request.resource.data.get('expiryTimestamp', 0) == resource.data.get('expiryTimestamp', 0));
      allow delete: if isAdmin() || (resource != null && resource.data.get('status', '') == 'deleted');
    }

    // Scanner Users
    match /dasmo_scanner_users/{email} {
      allow read: if isOwner(email) || isAdmin();
      allow create: if (isOwner(email) && 
                        (email.lower() == 'subhojitpaul26042004@gmail.com' ||
                         (request.resource.data.get('isApproved', false) == false &&
                          request.resource.data.get('role', 'user') == 'user' &&
                          request.resource.data.get('status', 'pending') == 'pending'))) || isAdmin();
      allow update: if isAdmin() || 
                       (isOwner(email) && 
                        request.resource.data.get('isApproved', false) == resource.data.get('isApproved', false) &&
                        request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending') &&
                        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
                        request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
                        request.resource.data.get('expiryTimestamp', 0) == resource.data.get('expiryTimestamp', 0));
      allow delete: if isAdmin() || (resource != null && resource.data.get('status', '') == 'deleted');
    }

    // PC Users
    match /dasmo_pc_users/{email} {
      allow read: if isOwner(email) || isAdmin();
      allow create: if isAdmin() ||
                       (isOwner(email) && 
                        ((isRegistrationOpen() && 
                          request.resource.data.get('role', 'user') == 'user' &&
                          request.resource.data.get('isAdmin', false) == false) ||
                         (request.resource.data.get('isApproved', false) == false &&
                          request.resource.data.get('role', 'user') == 'user' &&
                          request.resource.data.get('isAdmin', false) == false &&
                          request.resource.data.get('status', 'pending') == 'pending')));
      allow update: if isAdmin() || 
                       (isOwner(email) && 
                        request.resource.data.get('isApproved', false) == resource.data.get('isApproved', false) &&
                        request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending') &&
                        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
                        request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
                        request.resource.data.get('expiryTimestamp', 0) == resource.data.get('expiryTimestamp', 0) &&
                        (resource.data.get('deviceId', '') == '' || request.resource.data.get('deviceId', '') == resource.data.get('deviceId', '')));
      allow delete: if isAdmin() || (resource != null && resource.data.get('status', '') == 'deleted');
    }

    // Cyber Capture Users
    match /dasmo_cyber_capture_users/{email} {
      allow read: if isOwner(email) || isAdmin();
      allow create: if (isOwner(email) && 
                        (email.lower() == 'subhojitpaul26042004@gmail.com' ||
                         (request.resource.data.get('isApproved', false) == false &&
                          request.resource.data.get('role', 'user') == 'user' &&
                          request.resource.data.get('status', 'pending') == 'pending'))) || isAdmin();
      allow update: if isAdmin() || 
                       (isOwner(email) && 
                        request.resource.data.get('isApproved', false) == resource.data.get('isApproved', false) &&
                        request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending') &&
                        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
                        request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
                        request.resource.data.get('expiryTimestamp', 0) == resource.data.get('expiryTimestamp', 0));
      allow delete: if isAdmin() || (resource != null && resource.data.get('status', '') == 'deleted');
    }

    // Scanner Document Metadata
    match /dasmo_doc_scanner_documents/{documentId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 2. SMS & CALL FORWARDER COLLECTIONS
    // =========================================================================
    match /sms_forwarder_users/{userId} {
      allow read, write: if true;
    }

    match /sms_forwarder_pairings/{pairingCode} {
      allow read, write: if true;
    }

    match /sms_forwarder_links/{linkId} {
      allow read, write: if true;
    }

    match /sms_forwarder_messages/{hostUid}/{document=**} {
      allow read, write: if true;
    }

    match /sms_forwarder_calls/{hostUid}/{document=**} {
      allow read, write: if true;
    }

    match /sms_forwarder_wt_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Legacy SMS Bridge Collections
    match /pairings/{pairingCode} {
      allow read, write: if true;
    }

    match /links/{linkId} {
      allow read, write: if true;
    }

    match /sms/{hostUid}/{document=**} {
      allow read, write: if true;
    }

    // =========================================================================
    // 3. LKS DIALER & CHAT SYSTEM COLLECTIONS
    // =========================================================================

    // Users and subcollections (contacts, callLogs, linked_devices)
    match /users/{userId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Active calls, WebRTC signaling & ICE candidates
    match /calls/{callId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Ephemeral Inboxes (Chat messages & media payloads)
    match /inboxes/{recipientPhone} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Message delivery & read receipts (Acks)
    match /receipts/{recipientPhone} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Real-time typing indicators
    match /typingStatus/{recipientPhone} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // E2EE Group Chats
    match /groups/{groupId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // P2P WebRTC DataChannel transfer sessions & ICE signaling
    match /p2p_transfer_sessions/{sessionId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /p2p_transfers/{document=**} {
      allow read, write: if true;
    }

    // Web QR Code Login Sessions
    match /qr_sessions/{sessionId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Spam Reports & Blocked Numbers
    match /spam_reports/{document=**} {
      allow read, write: if true;
    }

    // App Diagnostics, Crash Reporting & Shake Logs
    match /critical_crashes/{document=**} {
      allow read, write: if true;
    }

    match /user_shake_reports/{document=**} {
      allow read, write: if true;
    }

    match /app_logs/{document=**} {
      allow read, write: if true;
    }
  }
}
