rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for schema integrity and security
    function isValidUser(data, phone) {
      return data.phoneNumber == phone
        && data.displayName is string
        && data.displayName.size() > 0;
    }

    function isValidCall(data, id) {
      return data.callId == id
        && data.callerNumber is string
        && data.calleeNumber is string
        && data.status in ['CALLING', 'RINGING', 'ANSWERED', 'ENDED', 'DECLINED', 'MISSED', 'FAILED'];
    }

    function isValidCandidate(data) {
      return data.type in ['offerCandidate', 'answerCandidate']
        && data.sdpCandidate is string;
    }

    function isValidCallLog(data) {
      return data.direction in ['INCOMING', 'OUTGOING', 'MISSED']
        && data.callType in ['AUDIO', 'VIDEO'];
    }

    function isValidChatMessage(data, id, recipientPhone) {
      return data.messageId == id
        && data.recipientNumber == recipientPhone
        && data.senderNumber is string
        && data.senderPublicKey is string
        && data.ciphertext is string
        && data.ciphertext.size() > 0
        && data.iv is string
        && data.iv.size() > 0
        && data.mediaType in ['TEXT', 'IMAGE', 'AUDIO', 'DOCUMENT', 'EDIT', 'DELETE', 'CHUNK'];
    }

    function isValidReceipt(data) {
      return data.messageId is string
        && data.senderNumber is string
        && data.recipientNumber is string
        && data.status in ['DELIVERED', 'READ'];
    }

    // User profiles & presence
    match /users/{phoneNumber} {
      allow read: if true;
      allow create: if isValidUser(request.resource.data, phoneNumber);
      allow update: if request.resource.data.phoneNumber == phoneNumber;
      allow delete: if false;

      // User contacts
      match /contacts/{contactId} {
        allow read: if true;
        allow create, update: if request.resource.data.name is string && request.resource.data.phoneNumber is string;
        allow delete: if true;
      }

      // Per-user call logs (created locally or by caller on missed call)
      match /callLogs/{logId} {
        allow read: if true;
        allow create: if isValidCallLog(request.resource.data);
        allow update: if true;
        allow delete: if true;
      }
    }

    // Active calls & signaling
    match /calls/{callId} {
      allow read: if true;
      allow create: if isValidCall(request.resource.data, callId);
      allow update: if true;
      allow delete: if true;

      // WebRTC ICE candidates subcollection
      match /candidates/{candidateId} {
        allow read: if true;
        allow create: if isValidCandidate(request.resource.data);
        allow update: if true;
        allow delete: if true;
      }
    }

    // Ephemeral End-to-End Encrypted Inboxes (Zero Server Retention)
    match /inboxes/{recipientPhone} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidChatMessage(request.resource.data, messageId, recipientPhone);
        allow update: if false;
        allow delete: if true;
      }
    }

    // Ephemeral Delivery & Read Receipts (Zero Server Retention)
    match /receipts/{recipientPhone} {
      allow read, write: if true;

      match /acks/{ackId} {
        allow read: if true;
        allow create: if isValidReceipt(request.resource.data);
        allow update: if false;
        allow delete: if true;
      }
    }

    // Ephemeral Typing Status (5s TTL)
    match /typingStatus/{targetPhone} {
      allow read, write: if true;

      match /peers/{peerPhone} {
        allow read: if true;
        allow write: if request.resource.data.isTyping is bool;
      }
    }
  }
}