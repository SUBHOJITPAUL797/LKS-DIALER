rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // LKS DIALER / RB DIALER — CLOUD FIRESTORE SECURITY RULES
    // Firebase Project ID: lks-dialer
    // =========================================================================
    // IMPORTANT NOTES FOR MAINTAINERS & AI ASSISTANTS:
    // 1. This Firebase project (`lks-dialer`) ONLY serves LKS Dialer / RB Dialer
    //    (Android: `com.subhojit.lksdialer.app`, Web: `lks-dialer-web`).
    //    Unrelated DASMO Suite & SMS Forwarder rules live in the separate
    //    `dasmo-scanner-android` Firebase project and were removed from here
    //    (along with the exposed DASMO adminKey). Do NOT mix other projects here.
    // 2. Authentication note: Android and Web clients currently identify users
    //    by verified phone number + device without Firebase Auth tokens
    //    (`request.auth == null`). Do NOT require `request.auth != null` unless
    //    Firebase Authentication is enabled on both Android and Web clients.
    // 3. Nested subcollection wildcards (`/{document=**}`) MUST be preserved
    //    for multi-level paths such as:
    //      - `calls/group_conference_hub/rooms/{roomId}/participants/{phone}`
    //      - `calls/group_conference_hub/rooms/{roomId}/links/{linkId}`
    //      - `{critical_crashes|user_shake_reports|app_logs}/{id}/log_chunks/{chunk}`
    // =========================================================================

    // Users & subcollections (contacts, callLogs, linked_devices)
    match /users/{userId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Active 1-on-1 calls, WebRTC signaling, ICE candidates (`candidates`),
    // and Group Conference Hub (`calls/group_conference_hub/rooms/{roomId}/...`)
    match /calls/{callId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Top-level Group Conference Calls path (kept for backwards compatibility)
    match /group_calls/{roomId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Ephemeral Inboxes (E2EE chat payloads, media, chunks, locations)
    match /inboxes/{recipientPhone} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Message delivery & read receipts (`acks`)
    match /receipts/{recipientPhone} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Real-time typing indicators (`peers`)
    match /typingStatus/{recipientPhone} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // E2EE Group Chats
    match /groups/{groupId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // P2P WebRTC DataChannel File Transfers (`sender_ice`, `receiver_ice`)
    match /p2p_transfers/{sessionId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Legacy P2P session path (kept for backwards compatibility)
    match /p2p_transfer_sessions/{sessionId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Web QR Code Login Sessions
    match /qr_sessions/{sessionId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Spam Reports & Blocked Numbers
    match /spam_reports/{reportId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // App Diagnostics, Crash Reporting, Shake Reports & Chunked Logs (`log_chunks`)
    match /critical_crashes/{crashId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /user_shake_reports/{reportId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /app_logs/{logId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }
  }
}
